{% if is_blocked %}
  <div class="layout layout--col gap--space-between">
    <div class="text--center">
      <span class="title">NWPS is blocking TRMNL servers (Error 403)</span>
    </div>
  </div>
{% else %}
<div class="layout">
  <!-- Key Metrics -->
  <div class="grid grid--cols-4 gap--space-between gap--medium">
    <div class="col col--span-2 col--center">
      <div class="grid grid--cols-2 gap--medium">
        {% render "metric_item",
          trmnl: trmnl,
          metric_value: observed_level,
          value_class: "value--medium lg:value--large value--tnums",
          label_class: "label--small lg:label--base",
          label_text: "Observed Level",
          unit_text: observed_level_unit,
          is_warning: is_flood_warning_current %}
        {% if forecast_level > 0 %}
          {% render "metric_item",
            trmnl: trmnl,
            metric_value: forecast_level,
            value_class: "value--medium lg:value--large value--tnums",
            label_class: "label--small lg:label--base",
            label_text: "Forecast Level",
            unit_text: forecast_level_unit,
            is_warning: is_flood_warning_forecast %}
        {% endif %}
        {% render "metric_item",
          trmnl: trmnl,
          metric_value: observed_flow,
          value_class: "value--medium lg:value--large value--tnums",
          label_class: "label--small lg:label--base",
          label_text: "Observed Flow",
          unit_text: observed_flow_unit,
          is_warning: false %}
        {% if forecast_flow > 0 %}
          {% render "metric_item",
            trmnl: trmnl,
            metric_value: forecast_flow,
            value_class: "value--medium lg:value--large value--tnums",
            label_class: "label--small lg:label--base",
            label_text: "Forecasted Flow",
            unit_text: forecast_flow_unit,
            is_warning: false %}
        {% endif %}
      </div>
    </div>
    <!-- Line Chart -->
    <div class="col col--span-2">
      <div id="{{ chart_id }}" class="h--min-[100cqh] w--full"></div>
    </div>
  </div>
</div>
{% endif %}

<!-- Title Bar -->
<div class="title_bar">
  <img class="image" src="https://raw.githubusercontent.com/stephenyeargin/trmnl-nwps-gauges/refs/heads/main/assets/noaa.svg" />
  <span class="title">{{ gauge.name | default: 'Unable to load gauge data' }} </span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>

<script>
  const gaugeLocale = {{ trmnl.user.locale | json }} || 'en-US';
  Highcharts.chart("{{ chart_id }}", {
    lang: { locale: gaugeLocale },
    chart: {
      type: "line",
      animation: false
    },
    title: {
      text: null
    },
    xAxis: {
      type: "datetime",
      labels: {
        style: {
          fontSize: "12px",
          color: "#000000"
        }
      },
      lineWidth: 0,
      gridLineDashStyle: "dot",
      tickWidth: 1,
      tickLength: 0,
      gridLineWidth: 1,
      gridLineColor: "#000000",
      tickPixelInterval: 80,
      plotLines: [{
        color: "#121212",
        width: 1,
        dashStyle: "Dash",
        value: Date.parse(now),
        label: {
          text: "Now",
          align: "center",
          style: {
            fontSize: "10px",
            color: "#121212"
          }
        }
      }]
    },
    yAxis: {
      min: chartMin,
      max: chartMax,
      labels: {
        style: {
          fontSize: "12px",
          color: "#000000"
        }
      },
      gridLineDashStyle: "solid",
      gridLineWidth: 1,
      gridLineColor: "#000000",
      tickAmount: 4,
      title: {
        text: "Water Level ({{ observed_level_unit }})",
        style: {
          fontSize: "12px"
        }
      },
      plotLines: plotLines.map(function(line) {
        return {
          ...line,
          dashStyle: "Dash"
        };
      })
    },
    plotOptions: {
      series: {
        animation: false,
        lineWidth: 2
      }
    },
    series: [
      {
        name: "Combined",
        data: combinedData,
        color: "black",
        curve: true
      }
    ],
    legend: {
      enabled: false
    },
    tooltip: {
      enabled: false
    },
    credits: {
      enabled: false
    }
  });
</script>
