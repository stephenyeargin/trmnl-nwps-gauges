{% if is_blocked %}
  <div class="layout layout--col gap--space-between">
    <div class="text--center">
      <span class="title title--large">NWPS is blocking TRMNL servers (Error 403)</span>
    </div>
  </div>
{% else %}
<div class="layout layout--col gap--space-between">
  <!-- Key Metrics -->
  <div class="grid grid--cols-4 gap--medium mb--5">
    {% render "metric_item",
      metric_value: observed_level,
      value_class: "value--large lg:value--xlarge value--tnums",
      label_class: "label--small lg:label--base",
      label_text: "Observed Level",
      unit_text: "ft",
      warning_unit_text: observed_level_unit,
      is_warning: is_flood_warning_current %}
    {% if forecast_level > 0 %}
      {% render "metric_item",
        metric_value: forecast_level,
        value_class: "value--large lg:value--xlarge value--tnums",
        label_class: "label--small lg:label--base",
        label_text: "Forecasted Level",
        unit_text: "ft",
        warning_unit_text: forecast_level_unit,
        is_warning: is_flood_warning_forecast %}
    {% endif %}
    {% render "metric_item",
      metric_value: observed_flow,
      value_class: "value--large lg:value--xlarge value--tnums",
      label_class: "label--small lg:label--base",
      label_text: "Observed Flow",
      unit_text: observed_flow_unit,
      is_warning: false %}
    {% if forecast_flow > 0 %}
      {% render "metric_item",
        metric_value: forecast_flow,
        value_class: "value--large lg:value--xlarge value--tnums",
        label_class: "label--small lg:label--base",
        label_text: "Forecasted Flow",
        unit_text: forecast_flow_unit,
        is_warning: false %}
    {% endif %}
  </div>

  <!-- Line Chart -->
  <div id="{{ chart_id }}" class="h--min-[75cqh] w--full"></div>
</div>
{% endif %}

<!-- Title Bar -->
<div class="title_bar">
  <img class="image" src="https://raw.githubusercontent.com/stephenyeargin/trmnl-nwps-gauges/refs/heads/main/assets/noaa.svg" />
  <span class="title">{{ gauge.name | default: 'Unable to load gauge data' }} </span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>

<script>
  Highcharts.chart("{{ chart_id }}", {
    chart: {
      type: "line",
      animation: false
    },
    title: {
      text: null
    },
    xAxis: {
      type: "datetime",
      labels: {
        style: {
          fontSize: "16px",
          color: "#000000"
        }
      },
      lineWidth: 0,
      gridLineDashStyle: "dot",
      tickWidth: 1,
      tickLength: 0,
      gridLineWidth: 1,
      gridLineColor: "#000000",
      tickPixelInterval: 120,
      plotLines: [{
        color: "#121212",
        width: 2,
        dashStyle: "Dash",
        value: Date.parse(now),
        label: {
          text: "Now",
          align: "center",
          style: {
            color: "#121212"
          }
        }
      }]
    },
    yAxis: {
      min: chartMin,
      max: chartMax,
      labels: {
        style: {
          fontSize: "16px",
          color: "#000000"
        }
      },
      gridLineDashStyle: "solid", // Revert horizontal grid lines to solid
      gridLineWidth: 1,
      gridLineColor: "#000000",
      tickAmount: 5,
      title: {
        text: "Water Level ({{ observed_level_unit }})"
      },
      plotLines: plotLines.map(function(line) {
        return {
          ...line,
          dashStyle: "Dash" // Ensure annotation lines are dashed
        };
      })
    },
    plotOptions: {
      series: {
        animation: false,
        lineWidth: 4
      }
    },
    series: [
      {
        name: "Combined",
        data: combinedData,
        color: "black",
        curve: true
      }
    ],
    legend: {
      enabled: false
    },
    tooltip: {
      enabled: false
    },
    credits: {
      enabled: false
    }
  });
</script>
